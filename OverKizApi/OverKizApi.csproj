<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>OverKizApi</RootNamespace>
	 <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	  <!-- Optional: enable the latest compiler and nullable analysis -->
	  <LangVersion>latest</LangVersion>
	  <Nullable>enable</Nullable>
	  <AnalysisLevel>latest-recommended</AnalysisLevel>
	  <EnableNETAnalyzers>true</EnableNETAnalyzers>
	  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	  <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
	  <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- Migrated from AssemblyInfo.cs -->
    <AssemblyTitle>OverKizApi</AssemblyTitle>
    <Company>Neil Colvin</Company>
    <Product>OverKizApi</Product>
    <Copyright>Copyright ©2026 Neil Colvin</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- NuGet package metadata -->
    <PackageId>OverkizClient</PackageId>
    <Version>1.0.0</Version>
    <Authors>Neil Colvin</Authors>
    <Description>A .NET client library for the Overkiz cloud and local REST API, enabling control and monitoring of Somfy, Atlantic Cozytouch, Hitachi Hi Kumo, and other Overkiz-compatible smart-home gateways and devices. Supports both cloud (OAuth2/cookie) and local (bearer token) connection modes, device discovery, state polling, command execution, and real-time event streaming.</Description>
    <PackageTags>overkiz;somfy;tahoma;smarthome;iot;rest;api;crestron</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/oznetmaster/OverkizClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/oznetmaster/OverkizClient</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ComVisible>false</ComVisible>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Enable XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\OverKizApi.xml</DocumentationFile>
  </PropertyGroup>

  <!-- Framework-specific build props -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <!-- Use semicolon-delimited symbols matching the code's #if checks -->
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <NoWarn>CRR0029,CRRSP08</NoWarn>
  </PropertyGroup>

 <!-- References only needed for .NET Framework -->
 <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <Reference Include="System.Runtime" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
 <ItemGroup>
   <None Remove="OverKizApi.pdb" />
 </ItemGroup>

  <!-- Packages common to both TFMs -->
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.1" />
    <!-- Newtonsoft.Json is not used by OverKizApi; it is already provided by Crestron Home -->
    <!-- <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" /> -->
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Polly.Extensions" Version="8.6.6" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.8" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <!-- Polyfills only for pre-.NET5 targets -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="RequiredMemberAttribute" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

 <!-- net472-specific packages -->
 <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

 <!-- Include CompilerServices shim only for net472: remove for other TFMs -->
 <ItemGroup Condition=" '$(TargetFramework)' != 'net472' ">
 <Compile Remove="CompilerServicesShim.cs" />
 </ItemGroup>
 <ItemGroup>
   <Folder Include=".template.config\" />
   <Folder Include="Annotations\" />
 </ItemGroup>
 <ItemGroup>
   <None Include="..\README.md" Pack="true" PackagePath="\" />
 </ItemGroup>

  <!-- Generate DocFX documentation on Release builds (net10.0 pass only to avoid running twice) -->
  <Target Name="GenerateDocFx"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net10.0'">
    <Message Text="Running DocFX (metadata)..." Importance="high" />
    <Exec Command="docfx metadata &quot;$(MSBuildThisFileDirectory)..\docs\docfx.json&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\docs"
          ContinueOnError="true" />
    <Message Text="Injecting cover page into api/toc.yml..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\docs\inject-cover.ps1&quot; -TocPath &quot;$(MSBuildThisFileDirectory)..\docs\api\toc.yml&quot;"
          ContinueOnError="true" />
    <Message Text="Running DocFX (site)..." Importance="high" />
    <Exec Command="docfx build &quot;$(MSBuildThisFileDirectory)..\docs\docfx.json&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\docs"
          ContinueOnError="true" />
    <Message Text="Running DocFX (pdf)..." Importance="high" />
    <Exec Command="docfx pdf &quot;$(MSBuildThisFileDirectory)..\docs\docfx.json&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\docs"
          ContinueOnError="true" />
    <Exec Command="move /Y &quot;$(MSBuildThisFileDirectory)..\docs\_pdf\OverKizApi_api.pdf&quot; &quot;$(MSBuildThisFileDirectory)..\docs\_pdf\OverKizApi.pdf&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
