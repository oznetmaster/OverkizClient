{
  "schema": 1,
  "tasks": {
    "test-test-run-isolated-api-tests": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "test",
            "OverKizApi.Tests/OverKizApi.Tests.csproj",
            "-c",
            "Release",
            "-f",
            "${env:BUILD_INPUT_0}",
            "--filter",
            "TestCategory!=Live",
            "--logger",
            "trx;LogFileName=tests.trx",
            "--results-directory",
            "artifacts/test-results/${env:BUILD_INPUT_1}"
          ]
        }
      ],
      "results": [
        "artifacts/test-results/${env:BUILD_INPUT_1}/**/*.trx"
      ]
    },
    "documentation": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "build",
            "OverKizApi/OverKizApi.csproj",
            "--configuration",
            "Release",
            "-p:ContinuousIntegrationBuild=true"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "tool",
            "restore"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "tool",
            "run",
            "docfx",
            "metadata",
            "docfx/docfx.json",
            "--property",
            "TargetFramework=net472;Configuration=Release"
          ]
        },
        {
          "executable": "dotnet",
          "arguments": [
            "tool",
            "run",
            "docfx",
            "build",
            "docfx/docfx.json",
            "--output",
            "./docfx-site"
          ]
        }
      ],
      "documentation": {
        "config": "docfx/docfx.json",
        "site": "docfx-site",
        "title": "OverkizClient"
      }
    }
  }
}
